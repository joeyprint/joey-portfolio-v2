---
import SideProjectCard from '@/components/SideProjectCard.astro';

const snippet = `<SideProjectCard
  title="Barcode Generator"
  description="A fast, browser-based barcode tool."
  href="https://labs.generate-barcode.wasin.dev/"
  tags={['Side project', 'Web tool']}
>
  <img slot="thumbnail" src="/assets/projects/…" alt="Preview" />
</SideProjectCard>`;
---

<section id="sidecard" class="sg-section">
	<header>
		<span class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">Component</span>
		<h2>Side-project card</h2>
		<p>
			The full showcase card — the entire element is an <code>&lt;a target="_blank"&gt;</code>.
			Cream surface, live badge, title + description on top, a thumbnail bleeding off the bottom
			edge via the <code>thumbnail</code> named slot.
		</p>
	</header>
	<div class="sg-spec">
		<div class="sg-stage plain">
			<SideProjectCard
				title="Barcode Generator Website"
				description="A fast, browser-based tool to generate and download barcodes — pick a symbology, type your value, export."
				href="https://labs.generate-barcode.wasin.dev/"
				tags={['Side project', 'Web tool', 'Barcodes']}
				style="max-width: 520px"
			>
				<div slot="thumbnail" class="bg-primary-900 flex h-full w-full items-center justify-center">
					<svg class="w-4/5" viewBox="0 0 320 120" role="img" aria-label="Barcode placeholder">
						<g fill="#f6f3ee">
							<rect x="10" y="14" width="4" height="74"></rect><rect
								x="18"
								y="14"
								width="2"
								height="74"></rect><rect x="24" y="14" width="6" height="74"></rect><rect
								x="34"
								y="14"
								width="3"
								height="74"></rect><rect x="41" y="14" width="8" height="74"></rect><rect
								x="53"
								y="14"
								width="2"
								height="74"></rect><rect x="59" y="14" width="5" height="74"></rect><rect
								x="68"
								y="14"
								width="3"
								height="74"></rect><rect x="75" y="14" width="7" height="74"></rect><rect
								x="86"
								y="14"
								width="2"
								height="74"></rect><rect x="92" y="14" width="4" height="74"></rect><rect
								x="100"
								y="14"
								width="6"
								height="74"></rect><rect x="110" y="14" width="2" height="74"></rect><rect
								x="116"
								y="14"
								width="5"
								height="74"></rect><rect x="125" y="14" width="3" height="74"></rect><rect
								x="132"
								y="14"
								width="8"
								height="74"></rect><rect x="144" y="14" width="2" height="74"></rect><rect
								x="150"
								y="14"
								width="4"
								height="74"></rect><rect x="158" y="14" width="6" height="74"></rect><rect
								x="168"
								y="14"
								width="3"
								height="74"></rect><rect x="175" y="14" width="7" height="74"></rect><rect
								x="186"
								y="14"
								width="2"
								height="74"></rect><rect x="192" y="14" width="5" height="74"></rect><rect
								x="201"
								y="14"
								width="3"
								height="74"></rect><rect x="208" y="14" width="8" height="74"></rect><rect
								x="220"
								y="14"
								width="2"
								height="74"></rect><rect x="226" y="14" width="4" height="74"></rect><rect
								x="234"
								y="14"
								width="6"
								height="74"></rect><rect x="244" y="14" width="3" height="74"></rect><rect
								x="251"
								y="14"
								width="7"
								height="74"></rect><rect x="262" y="14" width="2" height="74"></rect><rect
								x="268"
								y="14"
								width="5"
								height="74"></rect><rect x="277" y="14" width="3" height="74"></rect><rect
								x="284"
								y="14"
								width="8"
								height="74"></rect><rect x="296" y="14" width="2" height="74"></rect><rect
								x="302"
								y="14"
								width="4"
								height="74"></rect>
						</g>
						<text
							x="160"
							y="106"
							text-anchor="middle"
							fill="#d8c9a4"
							font-size="9"
							letter-spacing="0.32em"
							font-family="ui-monospace,monospace">GENERATE-BARCODE.WASIN.DEV</text
						>
					</svg>
				</div>
			</SideProjectCard>
		</div>
		<div class="sg-code">
			<button class="sg-copy" type="button">Copy</button>
			<pre><code set:text={snippet} /></pre>
		</div>
	</div>
</section>
