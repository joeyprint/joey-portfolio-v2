---
import WorkCard from '@/components/WorkCard.astro';

const snippet = `<WorkCard
  title="Project Name"
  description="Short project description here."
  category="Website"
  mark="AB"
  tags={['Product', 'Category']}
/>
<!-- imageUrl: replaces the tint bg with a real screenshot -->
<!-- mark: short text OR image URL (auto-detected) -->`;
---

<section id="workcard" class="sg-section">
	<header>
		<span class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">Component</span>
		<h2>Work card</h2>
		<p>
			16:9 thumbnail card that lifts on hover. The <code>mark</code> prop accepts short text (e.g. <code
				>"SET"</code
			>) or an image URL. Pass
			<code>imageUrl</code> to replace the tint with a real screenshot.
		</p>
	</header>

	<div class="sg-block">
		<div class="sg-spec">
			<div class="sg-stage plain">
				<div class="grid w-full grid-cols-2 gap-5">
					<WorkCard
						title="Project Name"
						description="Lorem ipsum dolor sit amet, consectetur adipiscing elit. Donec suscipit auctor dui, at volutpat."
						category="Website"
						mark="JW"
						tags={['development', 'design']}
					/>
				</div>
			</div>
			<div class="sg-code">
				<button class="sg-copy" type="button">Copy</button>
				<pre><code set:text={snippet} /></pre>
			</div>
		</div>
		<p class="sg-hint">
			Swap to a real screenshot: pass <code>imageUrl="/assets/projects/my-project.png"</code> — sizing
			and cropping are already handled.
		</p>
	</div>
</section>
