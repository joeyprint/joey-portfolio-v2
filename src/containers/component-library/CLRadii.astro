---

---

<section id="radii" class="sg-section">
	<header>
		<span class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">Foundations</span>
		<h2>Radii &amp; shadows</h2>
		<p>
			Convention: buttons use <code>rounded-lg</code> (10px), cards use <code>rounded-xl</code>
			(14px), pills go fully round. Shadows appear on hover, not at rest.
		</p>
	</header>

	<div class="sg-block">
		<div class="sg-block-title">Radii</div>
		<div class="sg-tiles">
			<div class="sg-tile">
				<div class="box" style="border-radius:6px">sm</div>
				<div class="cap">6px · thumb corners</div>
			</div>
			<div class="sg-tile">
				<div class="box" style="border-radius:8px">md</div>
				<div class="cap">8px · inputs / notes</div>
			</div>
			<div class="sg-tile">
				<div class="box" style="border-radius:10px">lg</div>
				<div class="cap">10px · buttons</div>
			</div>
			<div class="sg-tile">
				<div class="box" style="border-radius:14px">xl</div>
				<div class="cap">14px · cards</div>
			</div>
			<div class="sg-tile">
				<div class="box" style="border-radius:16px">2xl</div>
				<div class="cap">16px · contact card</div>
			</div>
			<div class="sg-tile">
				<div class="box" style="border-radius:9999px">pill</div>
				<div class="cap">9999px · chips / tags</div>
			</div>
		</div>
	</div>

	<div class="sg-block">
		<div class="sg-block-title">Shadows</div>
		<div class="sg-tiles">
			<div class="sg-tile shadow">
				<div class="box" style="box-shadow:0 1px 2px rgba(0,0,0,0.05);border-color:transparent">
					xs
				</div>
				<div class="cap">badge ring</div>
			</div>
			<div class="sg-tile shadow">
				<div class="box" style="box-shadow:0 4px 10px rgba(0,0,0,0.12);border-color:transparent">
					card
				</div>
				<div class="cap">card hover</div>
			</div>
			<div class="sg-tile shadow">
				<div class="box" style="box-shadow:0 4px 5px rgba(0,0,0,0.25);border-color:transparent">
					image
				</div>
				<div class="cap">anchored thumb</div>
			</div>
		</div>
	</div>
</section>
