---
import Container from '@/components/Container.astro';
import WorkCard from '@/components/WorkCard.astro';
import type { ComponentProps } from 'astro/types';

type WorkProject = ComponentProps<typeof WorkCard> & { title: string };

const workProjects: WorkProject[] = [
	{
		title: 'SET | Corporate Value Up',
		description:
			'To encourage and guide companies to enhance their corporate value through improved management and increased transparency.',
		imageUrl: 'assets/projects/set-cvup.png',
		category: 'Website',
		mark: 'SET',
		markColor: 'primary-900',
		tags: ['Development', 'Design', 'Product Management']
	},
	{
		title: 'BKK Food Bank Digital Back-office',
		description:
			'Products for BKK admins to manage products for sharing foods to vulnerable people.',
		imageUrl: 'assets/projects/foodbank.png',
		category: 'Back-office',
		mark: 'BKK',
		markColor: 'primary-700',
		tags: ['Development', 'Product Discovery', 'Product Management']
	},
	{
		title: 'TCASter Application',
		description:
			'A supporting app for high-school students to calculate admission scores and prepare for university entry.',
		imageUrl: 'assets/projects/tcaster-app.png',
		category: 'Mobile App',
		mark: 'TC',
		markColor: 'primary-700',
		tint: 'a',
		tags: ['Development']
	},
	{
		title: 'TCASter ExamHub',
		description:
			"A practice testing platform that simulates post-lesson exercises to help students prepare for Thailand's TCAS exams.",
		imageUrl: 'assets/projects/tcaster-examhub.png',
		category: 'Website',
		mark: 'EH',
		markColor: 'primary-500',
		tags: ['Development']
	},
	{
		title: 'TCASter Mock Exam',
		description:
			'A mock exam system that gives high-school students a realistic testing experience to gauge their performance.',
		imageUrl: 'assets/projects/tcaster-mock-exam.png',
		category: 'Website',
		mark: 'ME',
		markColor: 'primary-900',
		tags: ['Development']
	},
	{
		title: 'Learn Education | Question Bank',
		description:
			'An all-in-one examination platform for teachers to create exams, manage schedules, and maintain a central question bank.',
		imageUrl: 'assets/projects/question-management-system.png',
		category: 'Back-office',
		mark: 'QB',
		markColor: 'primary-700',
		tags: ['Development']
	},
	{
		title: 'Learnneo Application',
		description:
			'The best learning buddy for students to learn and track their progress and achievements.',
		imageUrl: 'assets/projects/learnneo.png',
		category: 'Mobile App',
		mark: 'LN',
		markColor: 'primary-500',
		tags: ['Development']
	},
	{
		title: 'Learn Satit Pattana Dashboard',
		description:
			"An interactive dashboard for tracking students' academic progress and supporting their individual learning journeys.",
		imageUrl: 'assets/projects/learn-satit-pattana.png',
		category: 'Website',
		mark: 'SP',
		markColor: 'primary-900',
		tags: ['Development']
	},
	{
		title: 'NIA Feed',
		description:
			'A website for the National Innovation Agency (NIA) to share news and information about the organization.',
		imageUrl: 'assets/projects/nia-feed.png',
		category: 'Website',
		mark: 'NIA',
		markColor: 'primary-700',
		tags: ['Development']
	},
	{
		title: 'CalledP',
		description:
			'A personalized fashion brand website that empowers self-expression through every stitch.',
		imageUrl: 'assets/projects/called-p.png',
		category: 'Website',
		mark: 'CP',
		markColor: 'primary-900',
		tags: ['Development']
	}
];
---

<section id="work" class="py-16">
	<Container>
		<div>
			<p class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">From my work</p>
			<h2 class="joey_heading2 mt-1.5">Work projects</h2>
			<p class="joey_body1 text-typography-secondary mt-2.5">
				Products built with teams, in production, for real users.
			</p>
		</div>
		<div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
			{workProjects.map((project) => <WorkCard {...project} />)}
		</div>
	</Container>
</section>
