---
import Container from '@/components/Container.astro';
import SideProjectCard from '@/components/SideProjectCard.astro';

const sideProjects = [
	{
		title: 'Motion Mouse Movement',
		description:
			'Vibe code experiment: a webpage that tracks your mouse movement. Built for fun and to explore creative coding.',
		href: 'https://labs.mouse-movement.wasin.dev/',
		tags: ['Vibe Coding', 'Motion', 'Mouse Tracking'],
		imageUrl: 'assets/side-projects/mouse-movement.png'
	},
	{
		title: '24 Game Solver',
		description:
			'A math puzzle game where you combine them using arithmetic operations to reach the target number 24.',
		href: 'https://24game.wasin.dev/',
		tags: ['Vibe Coding', 'Game', 'Mathematics'],
		imageUrl: 'assets/side-projects/24-game.png'
	},
	{
		title: 'Barcode Generator Website',
		description:
			'A fast, browser-based tool to generate and download barcodes — pick a symbology, type your value, export. Built to scratch my own itch.',
		href: 'https://labs.generate-barcode.wasin.dev/',
		tags: ['Web Tools', 'Barcode'],
		imageUrl: 'assets/side-projects/generate-barcode.png'
	}
];
---

<section id="side-projects" class="bg-grayscale-50 py-16">
	<Container>
		<div>
			<p class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">From my playground</p>
			<h2 class="joey_heading2 mt-1.5">Side projects</h2>
			<p class="joey_body1 text-typography-secondary mt-2.5">
				Things I build on my own time. Each one links to its live playground.
			</p>
		</div>
		<div class="mt-10 grid grid-cols-1 gap-4 md:grid-cols-2 lg:grid-cols-3">
			{sideProjects.length > 0 && sideProjects.map((project) => <SideProjectCard {...project} />)}
		</div>
	</Container>
</section>
