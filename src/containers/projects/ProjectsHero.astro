---
import Container from '@/components/Container.astro';
---

<section class="bg-primary-100 border-primary-300/60 border-b pt-[72px] pb-16">
	<Container>
		<p class="joey_body2_bold text-primary-700 tracking-[0.18em] uppercase">Portfolio</p>
		<h1 class="joey_quote mt-2">Projects</h1>
		<p class="joey_subtitle1 text-typography-secondary mt-[18px] max-w-[640px]">
			A selection of products I've shipped at work, plus the things I build for myself in the
			playground — where I get to experiment without a brief.
		</p>

		<div class="mt-8 flex flex-wrap items-center gap-3">
			<span
				class="joey_body2 border-primary-300/70 text-primary-900 inline-flex items-center gap-2 rounded-full border bg-white px-[14px] py-[7px] font-semibold"
			>
				<span class="text-primary-500 font-bold">10</span> work projects
			</span>
			<span
				class="joey_body2 border-primary-300/70 text-primary-900 inline-flex items-center gap-2 rounded-full border bg-white px-[14px] py-[7px] font-semibold"
			>
				<span class="text-primary-500 font-bold">3</span> side project
			</span>
			<span
				class="joey_body2 border-primary-300/70 text-primary-900 inline-flex items-center gap-2 rounded-full border bg-white px-[14px] py-[7px] font-semibold"
			>
				<span class="text-primary-500 font-bold">2</span> activity
			</span>
			<a
				href="#side-projects"
				class="joey_body2 border-primary-300/70 text-primary-900 hover:bg-primary-100 inline-flex cursor-pointer items-center gap-2 rounded-full border bg-white px-[14px] py-[7px] font-semibold transition-colors duration-300"
			>
				Jump to side projects ↓
			</a>
		</div>
	</Container>
</section>
