---
import { cn } from '@/lib/utils';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
	class?: string;
}

const { class: className, ...restProps } = Astro.props;
---

<span
	{...restProps}
	class={cn(
		'joey_caption inline-flex items-center rounded-full border border-primary-300/70 bg-white px-3 py-1 font-semibold text-primary-900',
		className
	)}
>
	<slot />
</span>
