---
import { cn } from '@/lib/utils';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'span'> {
	text?: string;
	class?: string;
}

const { text = 'Live playground', class: className, ...restProps } = Astro.props;
---

<span
	{...restProps}
	class={cn(
		'joey_caption inline-flex items-center gap-2 font-bold uppercase tracking-[0.1em] text-primary-700',
		className
	)}
>
	<span class="live-dot" aria-hidden="true"></span>
	{text}
</span>

<style>
	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 color-mix(in srgb, var(--color-primary-500) 55%, transparent);
		}
		70% {
			box-shadow: 0 0 0 9px transparent;
		}
		100% {
			box-shadow: 0 0 0 0 transparent;
		}
	}

	.live-dot {
		width: 8px;
		height: 8px;
		border-radius: 50%;
		background: var(--color-primary-500);
		flex-shrink: 0;
		animation: pulse 2.2s infinite;
	}

	@media (prefers-reduced-motion: reduce) {
		.live-dot {
			animation: none;
		}
	}
</style>
