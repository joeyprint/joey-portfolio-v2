---
import { cn } from '@/lib/utils';
import LiveBadge from '@/components/LiveBadge.astro';
import Tag from '@/components/Tag.astro';
import type { HTMLAttributes } from 'astro/types';

interface Props extends HTMLAttributes<'a'> {
	title: string;
	description: string;
	href: string;
	tags?: string[];
	linkText?: string;
	class?: string;
}

const {
	title,
	description,
	href,
	tags = [],
	linkText = 'Visit playground',
	class: className,
	...restProps
} = Astro.props;
---

<a
	{...restProps}
	href={href}
	target="_blank"
	rel="noopener noreferrer"
	class={cn(
		'group relative flex flex-col overflow-hidden rounded-xl border pb-0 transition-colors duration-300',
		'border-primary-300/45 bg-primary-100 hover:bg-primary-300/50',
		'px-7 pt-7',
		className
	)}
>
	<!-- Head -->
	<div class="flex items-start justify-between gap-4">
		<div>
			<LiveBadge />
			<h3 class="joey_subtitle2_bold mt-2">{title}</h3>
			<p class="joey_body2 text-typography-secondary mt-3 max-w-[46ch]">{description}</p>
		</div>
	</div>

	<!-- Tags -->
	{
		tags.length > 0 && (
			<div class="mt-[18px] flex flex-wrap gap-2">
				{tags.map((tag) => (
					<Tag>{tag}</Tag>
				))}
			</div>
		)
	}

	<!-- Arrow link -->
	<span
		class="text-primary-700 group-hover:text-primary-900 mt-[18px] inline-flex items-center gap-[6px] text-[15px] font-bold transition-[gap,color] duration-[250ms] group-hover:gap-[11px]"
	>
		{linkText}
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" class="h-[18px] w-[18px] flex-shrink-0">
			<path
				d="M7 17L17 7M17 7H9M17 7v8"
				stroke="currentColor"
				stroke-width="2"
				stroke-linecap="round"
				stroke-linejoin="round"></path>
		</svg>
	</span>

	<!-- Thumbnail — bleeds off bottom edge -->
	<div class="shadow-image mt-[26px] aspect-(--aspect-ratio-16-9) overflow-hidden rounded-t-sm">
		<slot name="thumbnail" />
	</div>
</a>
